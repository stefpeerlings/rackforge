# RackForge — alleen lokaal netwerk.
# DNS: {$DEPLOY_DOMAIN} → {$DEPLOY_HOST} via lokale DNS (dnsmasq / router).
# {$DEPLOY_HOST}/{$DEPLOY_DOMAIN} komen uit de omgeving — zet ze via een
# systemd EnvironmentFile voor de caddy.service, of vul ze hier direct in.
# Certificaten: zie scripts/setup-local-tls.sh (mkcert, LAN-only).

http://{$DEPLOY_HOST}, http://{$DEPLOY_DOMAIN}, http://www.{$DEPLOY_DOMAIN} {
	redir https://{host}{uri} permanent
}

https://{$DEPLOY_HOST}, https://{$DEPLOY_DOMAIN}, https://www.{$DEPLOY_DOMAIN} {
	tls /var/www/html/private-certs/lan.pem /var/www/html/private-certs/lan-key.pem
	root * /var/www/html

	handle /private-certs/* {
		respond 404
	}

	handle /admin* {
		reverse_proxy 127.0.0.1:8080
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	redir /index.html /{?query} permanent
	redir /login.html /login{?query} permanent
	redir /main.html /main{?query} permanent
	redir /settings.html /settings{?query} permanent
	redir /privacy.html /privacy{?query} permanent
	redir /terms.html /terms{?query} permanent
	redir /verify-email.html /verify-email{?query} permanent
	redir /reset-password.html /reset-password{?query} permanent

	handle /login {
		rewrite * /login.html
		file_server
	}
	handle /main {
		rewrite * /main.html
		file_server
	}
	handle /settings {
		rewrite * /settings.html
		file_server
	}
	handle /privacy {
		rewrite * /privacy.html
		file_server
	}
	handle /terms {
		rewrite * /terms.html
		file_server
	}
	handle /verify-email {
		rewrite * /verify-email.html
		file_server
	}
	handle /reset-password {
		rewrite * /reset-password.html
		file_server
	}

	handle {
		file_server
	}
}