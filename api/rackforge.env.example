# RackForge — Docker omgevingsvariabelen voor de API-container.
# Kopieer naar api/rackforge.env en vul in (dit bestand wordt nooit gecommit,
# zie .gitignore).

# --- Verplicht ---
# Bootstrap-login: gebruikersnaam "admin" + dit wachtwoord (rol Owner).
# Genereer bijv.: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
RACKFORGE_ADMIN_PASSWORD=VERVANG_MET_LANG_WACHTWOORD

# Publieke URL van deze instance (voor links in e-mails). Moet overeenkomen
# met DOMAIN uit de .env in de repo-root.
RACKFORGE_APP_URL=https://jouwdomein.nl

# Alleen aanpassen bij lokaal/LAN-only testen zonder TLS (DOMAIN=localhost
# in de .env): zet op 0, anders weigert de browser de sessie-cookie over
# platte HTTP en werkt inloggen niet. Met een echt domein (HTTPS) altijd op
# de standaardwaarde 1 laten staan.
# RACKFORGE_SECURE_COOKIE=0

# --- Licentie (optioneel) ---
# Community-tier werkt zonder licentie. Voor Pro/Enterprise: plak de key die
# je van de leverancier hebt gekregen. Kan ook later via het admin-paneel
# (Licentie) worden ingevoerd zonder herstart — deze env var is vooral handig
# voor geautomatiseerde/scripted deploys.
# RACKFORGE_LICENSE_KEY=

# --- E-mail / SMTP (optioneel, nodig voor wachtwoord-reset & verificatie) ---
# RACKFORGE_SMTP_HOST=smtp.voorbeeld.nl
# RACKFORGE_SMTP_PORT=587
# RACKFORGE_SMTP_USER=noreply@jouwdomein.nl
# RACKFORGE_SMTP_PASS=
# RACKFORGE_SMTP_FROM=RackForge <noreply@jouwdomein.nl>

# --- Google OAuth (optioneel) ---
# Authorized redirect URI: https://jouwdomein.nl/api/auth/google/callback
# RACKFORGE_GOOGLE_CLIENT_ID=
# RACKFORGE_GOOGLE_CLIENT_SECRET=
