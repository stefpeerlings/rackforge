# RackForge admin dashboard — ~/.config/rackforge/admin.env
# Bootstrap-login: gebruikersnaam "admin" + dit wachtwoord (superbeheerder).
# Extra admins met rollen voeg je toe via Admin → Admin-gebruikers.
# Genereer bijv.: python -c "import secrets; print(secrets.token_urlsafe(24))"
RACKFORGE_ADMIN_PASSWORD=VERVANG_MET_LANG_WACHTWOORD
# Optioneel: e-mail voor wachtwoord-reset van bootstrap-owner (als geen gekoppeld app-account)
# RACKFORGE_ADMIN_RESET_EMAIL=owner@voorbeeld.nl