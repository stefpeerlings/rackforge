# docker-compose omgevingsvariabelen — kopieer naar .env

# Publiek domein waarop deze RackForge-instance bereikbaar is.
# Met SCHEME=https (default): Caddy vraagt hiervoor automatisch een Let's
# Encrypt-certificaat aan (poort 80 + 443 moeten dan vanaf internet
# bereikbaar zijn, en DOMAIN moet er via DNS naartoe wijzen).
DOMAIN=jouwdomein.nl

# Lokaal/LAN-only testen zonder eigen domein? Zet SCHEME op http en DOMAIN op
# het IP (of de LAN-hostnaam) waarmee je de server daadwerkelijk benadert,
# bv.:
#   SCHEME=http
#   DOMAIN=10.0.10.111
# "localhost" als DOMAIN werkt hierbij NIET als je van een andere machine
# binnenkomt — Caddy matcht dan alleen requests met Host: localhost.
# SCHEME=http

# Zet ook RACKFORGE_SECURE_COOKIE=0 in api/rackforge.env wanneer SCHEME=http,
# anders weigert de browser de sessie-cookie en werkt inloggen niet.
