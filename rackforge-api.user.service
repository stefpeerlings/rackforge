[Unit]
Description=RackForge API (SQLite)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/rackforge
EnvironmentFile=-%h/.config/rackforge/smtp.env
EnvironmentFile=-%h/.config/rackforge/google.env
EnvironmentFile=-%h/.config/rackforge/admin.env
Environment=RACKFORGE_DB=%h/rackforge/plans.db
Environment=RACKFORGE_STATIC_DIR=%h/rackforge/static
Environment=RACKFORGE_HOST=0.0.0.0
Environment=RACKFORGE_PORT=8080
ExecStart=/usr/bin/python3 %h/rackforge/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target